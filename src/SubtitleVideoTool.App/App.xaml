<Application x:Class="SubtitleVideoTool.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Only the theme-independent scales are merged here. The colour
                    palette is appended at runtime by App.ApplyTheme, which keeps
                    a reference to the dictionary it owns: ThemeMode="System"
                    makes WPF insert its own Fluent dictionary into this same
                    collection, so positions here are not stable.
                -->
                <ResourceDictionary Source="Theme/Common.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
