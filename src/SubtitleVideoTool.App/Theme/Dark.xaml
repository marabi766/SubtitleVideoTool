<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Section 6 of the design, dark column. Same keys as Light.xaml. -->

    <Color x:Key="WindowBackgroundColor">#1F1F1F</Color>
    <Color x:Key="CardBackgroundColor">#2B2B2B</Color>
    <Color x:Key="ControlFillColor">#333333</Color>
    <Color x:Key="StrokeColor">#383838</Color>
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#CFCFCF</Color>
    <Color x:Key="AccentColor">#60CDFF</Color>
    <Color x:Key="AccentHoverColor">#8AD9FF</Color>
    <Color x:Key="SuccessColor">#6CCB5F</Color>
    <Color x:Key="CautionColor">#F2C94C</Color>
    <Color x:Key="CriticalColor">#FF99A4</Color>

    <Color x:Key="SuccessSurfaceColor">#17301A</Color>
    <Color x:Key="CautionSurfaceColor">#3A2D14</Color>
    <Color x:Key="CriticalSurfaceColor">#442726</Color>
    <Color x:Key="SubtleSurfaceColor">#262626</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="ControlFillBrush" Color="{StaticResource ControlFillColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="CautionBrush" Color="{StaticResource CautionColor}" />
    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="{StaticResource SuccessSurfaceColor}" />
    <SolidColorBrush x:Key="CautionSurfaceBrush" Color="{StaticResource CautionSurfaceColor}" />
    <SolidColorBrush x:Key="CriticalSurfaceBrush" Color="{StaticResource CriticalSurfaceColor}" />
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="{StaticResource SubtleSurfaceColor}" />

    <!-- The dark accent is light, so text on it must be dark to stay legible. -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#7A7A7A" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#14FFFFFF" />

</ResourceDictionary>
