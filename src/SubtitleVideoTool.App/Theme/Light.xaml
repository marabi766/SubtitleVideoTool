<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Section 6 of the design, light column. Names follow WinUI resource keys
        where one already exists.
    -->

    <Color x:Key="WindowBackgroundColor">#F3F3F3</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="ControlFillColor">#FDFDFD</Color>
    <Color x:Key="StrokeColor">#E5E5E5</Color>
    <Color x:Key="TextPrimaryColor">#1B1B1B</Color>
    <Color x:Key="TextSecondaryColor">#5E5E5E</Color>
    <Color x:Key="AccentColor">#005FB8</Color>
    <Color x:Key="AccentHoverColor">#1A6FC4</Color>
    <Color x:Key="SuccessColor">#0F7B0F</Color>
    <Color x:Key="CautionColor">#9D5D00</Color>
    <Color x:Key="CriticalColor">#C42B1C</Color>

    <!-- Tinted surfaces are the WinUI InfoBar backgrounds. -->
    <Color x:Key="SuccessSurfaceColor">#DFF6DD</Color>
    <Color x:Key="CautionSurfaceColor">#FFF4CE</Color>
    <Color x:Key="CriticalSurfaceColor">#FDE7E9</Color>
    <Color x:Key="SubtleSurfaceColor">#F6F6F6</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="ControlFillBrush" Color="{StaticResource ControlFillColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="CautionBrush" Color="{StaticResource CautionColor}" />
    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="{StaticResource SuccessSurfaceColor}" />
    <SolidColorBrush x:Key="CautionSurfaceBrush" Color="{StaticResource CautionSurfaceColor}" />
    <SolidColorBrush x:Key="CriticalSurfaceBrush" Color="{StaticResource CriticalSurfaceColor}" />
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="{StaticResource SubtleSurfaceColor}" />

    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0A000000" />

</ResourceDictionary>
