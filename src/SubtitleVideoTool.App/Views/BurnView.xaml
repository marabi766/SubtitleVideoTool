<UserControl x:Class="SubtitleVideoTool.App.Views.BurnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SubtitleVideoTool.App">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:StringToVisibilityConverter x:Key="StringToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Video -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Video file"
                       Style="{StaticResource BodyText}" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,8,12"
                     Text="{Binding VideoPath, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Choose a video file" />
            <Button Grid.Row="0" Grid.Column="2" Margin="0,0,0,12" Content="Browse…"
                    Style="{StaticResource StandardButton}" Command="{Binding BrowseVideoCommand}" />

            <!-- Subtitle -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Subtitle file"
                       Style="{StaticResource BodyText}" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,0"
                     Text="{Binding SubtitlePath, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Choose an .srt file" />
            <Button Grid.Row="1" Grid.Column="2" Content="Browse…"
                    Style="{StaticResource StandardButton}" Command="{Binding BrowseSubtitleCommand}" />

            <!--
                The downloaded subtitle, offered rather than chosen: it sits
                directly beneath the empty field with its provenance attached,
                and disappears once a subtitle is picked.
            -->
            <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                    Style="{StaticResource SubtleCard}"
                    Padding="12"
                    Margin="0,8,0,12"
                    Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SuggestedSubtitleName}" Style="{StaticResource BodyStrongText}" />
                        <TextBlock Text="{Binding SuggestedSubtitleNote}" Style="{StaticResource CaptionText}"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding SuggestedSubtitleNote, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Use this" Margin="12,0,8,0"
                            Style="{StaticResource SmallButton}" Command="{Binding UseSuggestionCommand}" />
                </Grid>
            </Border>

            <!-- Output -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Output file"
                       Style="{StaticResource BodyText}" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,8,16"
                     Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Where to save the result" />
            <Button Grid.Row="3" Grid.Column="2" Margin="0,0,0,16" Content="Browse…"
                    Style="{StaticResource StandardButton}" Command="{Binding BrowseOutputCommand}" />

            <!-- Style: one row, because these four settings are one decision. -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Subtitle style"
                       Style="{StaticResource BodyText}" VerticalAlignment="Center" />
            <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                        Orientation="Horizontal" Margin="0,0,0,12">
                <TextBox Width="170" Margin="0,0,8,0"
                         Text="{Binding FontName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Width="60" Margin="0,0,4,0"
                         Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="pt" Style="{StaticResource SecondaryText}"
                           VerticalAlignment="Center" Margin="0,0,16,0" />

                <Button x:Name="TextColourButton" Click="PickTextColour"
                        Style="{StaticResource StandardButton}" Margin="0,0,8,0" Padding="8,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="16" Height="16" CornerRadius="2" Margin="0,0,8,0"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                Background="{Binding TextBrush}" />
                        <TextBlock Text="Text" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="BackgroundColourButton" Click="PickBackgroundColour"
                        Style="{StaticResource StandardButton}" Padding="8,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="16" Height="16" CornerRadius="2" Margin="0,0,8,0"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                Background="{Binding BackgroundBrush}" />
                        <TextBlock Text="Background" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Also compress -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Also compress"
                       Style="{StaticResource BodyText}" VerticalAlignment="Center" />
            <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Shrink the result to a size limit"
                              IsChecked="{Binding AlsoCompress}" Margin="0,0,16,0" />
                    <TextBox Width="80" Margin="0,0,8,0"
                             IsEnabled="{Binding AlsoCompress}"
                             Text="{Binding SizeLimitMb, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="MB" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Resolution is lowered only if the size target cannot be met at the current one."
                           Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Start -->
            <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                        HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Start burning"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartCommand}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
