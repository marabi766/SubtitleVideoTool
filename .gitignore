# --- Build output ---
/build/
*.zip
*.exe.tmp

# --- Bundled third-party binaries (large, downloaded separately) ---
# Verified with CHECKSUMS-SHA256.txt, not stored in Git.
/tools/*.exe

# --- PO-token provider's npm dependency tree ---
# Restored by `npm install --omit=dev` (Build-Msi.ps1 does this); its own
# integrity is verified via package-lock.json's per-package hashes, so it
# does not need an entry in CHECKSUMS-SHA256.txt.
/tools/pot-provider/server/node_modules/

# --- Secrets / private session data (never commit) ---
cookies.txt
cookies*.txt
*.cookies
*cookies*.sqlite
*.netscape
/secrets/
.env
.env.*

# --- Downloaded or generated media ---
/downloads/
*.mp4
*.mkv
*.webm
*.mov
*.m4v
*.m4a
*.mp3
*.srt
*.vtt
*.ass
*.part
*.ytdl
*.f???.*

# --- Local tooling state ---
/.claude/

# --- Temporary / scratch ---
/tmp/
/temp/
*.log
*.tmp
*.bak
*~
Thumbs.db
desktop.ini

# .NET build output
[Bb]in/
[Oo]bj/
*.user

